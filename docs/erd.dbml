Project StockAlert {
  database_type: 'PostgreSQL'
  Note: 'A user owns categories, products, and stock movement records. Product quantity is changed through stock movements.'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  password_hash text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  name varchar(100) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
}

Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  category_id uuid [ref: > categories.id, note: 'Nullable; set null if category is deleted']
  name varchar(150) [not null]
  sku varchar(100) [not null]
  quantity integer [not null, default: 0]
  minimum_stock_level integer [not null, default: 5]
  unit_price decimal(12,2)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, sku) [unique, name: 'products_user_id_sku_unique']
  }
}

Enum stock_movement_type {
  STOCK_IN
  STOCK_OUT
}

Table stock_movements {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  product_id uuid [not null, ref: > products.id]
  type stock_movement_type [not null]
  quantity integer [not null, note: 'Positive number of units moved']
  note text
  created_at timestamptz [not null, default: `now()`]
}

